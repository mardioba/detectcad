# ============================================================================
# CONTADOR DE CADEIRAS — configuração
# Copie este arquivo para .env  (cp .env.example .env) e edite os valores.
#
# IMPORTANTE: a URL RTSP com usuário e senha fica AQUI, nunca no código,
# nunca no dashboard. O backend mascara a senha antes de mostrar na tela.
# ============================================================================

# ----------------------------- CÂMERA ---------------------------------------
# Formato: rtsp://USUARIO:SENHA@IP:PORTA/CAMINHO
# Exemplos de ONVIF: rtsp://usuario:senha@192.168.0.252:554/onvif1
#                   rtsp://usuario:senha@192.168.0.252:554/Streaming/Channels/101
#                   rtsp://usuario:senha@192.168.0.252:554/live
CAMERA_RTSP_URL=
CAMERA_NAME=Camera 1

# FPS de processamento da IA. A câmera pode entregar 25 FPS; 3-5 basta e
# libera CPU/GPU. Se subir muito, o dashboard fica lento.
PROCESS_FPS=3

# Timeout (segundos) para abrir a câmera e para ler um frame.
CAMERA_OPEN_TIMEOUT_SEC=8
CAMERA_READ_TIMEOUT_SEC=10
# 0 = reconexão infinita (recomendado para operação contínua)
CAMERA_MAX_RETRIES=0
CAMERA_RETRY_DELAY_SEC=3
# tcp é o mais estável; udp tem menor latência mas perde pacotes.
CAMERA_TRANSPORT=tcp
# 1 ou 2 = o worker sempre pega o frame mais recente (sem atraso)
CAMERA_FRAME_BUFFER_SIZE=2

# ------------------------------ MODELO -------------------------------------
# Caminho do modelo YOLO treinado com as cadeiras da empresa.
# Enquanto esse arquivo não existir, o sistema roda em "modo de preparação":
# mostra a câmera e avisa que o modelo ainda não foi treinado.
YOLO_MODEL=data/models/chair_counter.pt

# auto = CUDA se disponível, senão CPU (recomendado)
# Aceita: auto | cpu | cuda | cuda:0 | 0
DEVICE=auto

# Limiar de confiança do YOLO. Menor = detecta mais (mais falsos positivos).
CONFIDENCE_THRESHOLD=0.50
# IoU do NMS do YOLO.
IOU_THRESHOLD=0.45
# Resolução de inferência (640 é o padrão equilibrado do YOLO).
IMGSZ=640
# Tamanho máximo de detecções por frame.
MAX_DET=300
# Tracker: internal (próprio, padrão) | bytetrack | botsort
TRACKER=internal

# Classes do modelo. NORMALMENTE a gente só tem "chair".
# Se o modelo também tiver a classe "pile" (pilha inteira), informe aqui.
CHAIR_CLASSES=chair
PILE_CLASSES=pile
# Quantas cadeiras cada detecção de "chair" representa (1.0 = uma por uma).
CHAIR_WEIGHT=1.0

# ------------------------------ CONTAGEM -----------------------------------
# Janela de estabilidade: quantos frames o filtro observa antes de trocar
# o número exibido no dashboard. 10 frames a 3 FPS = ~3,3 s.
COUNT_STABILITY_FRAMES=10
# Como agregar a janela: mode (votação, recomendado) | median | mean
STABILITY_MODE=mode
# Frames consecutivos exigidos para aceitar uma nova contagem.
CHANGE_MIN_FRAMES=3
# Método de contagem: auto | periodicity | detections | size
COUNTING_METHOD=auto
# Abaixo desta confiança a pilha entra em LOW_CONFIDENCE.
MIN_CONFIDENCE=0.55
# Abaixo desta concordância temporal a pilha entra em UNSTABLE.
STABILITY_MIN_CONFIDENCE=0.60
# Altura de UMA cadeira em pixels na imagem da câmera. 0 = não calibrado.
# Medir na página Calibração ("Medir cadeira") é o jeito certo.
CHAIR_HEIGHT_PX=0
# Sobreposição horizontal mínima (0-1) para juntar duas detecções na mesma pilha.
PILE_OVERLAP_MIN=0.30
# Distância horizontal (px) que separa duas pilhas distintas.
PILE_GAP_PX=40
# Frames sem detecção antes de considerar a pilha desaparecida.
MISS_GRACE_FRAMES=15

# ------------------------- ROI / CALIBRAÇÃO --------------------------------
# Liga o corte de área. Também configurável pelo dashboard.
CALIBRATION_ENABLED=false
# x,y,w,h em pixels da imagem original. Vazio = imagem inteira.
CALIBRATION_ROI=
# Ignora esta faixa vertical no topo (ex.: 12 = ignora os 12% de cima)
CEILING_Y_PCT=0
# Limite inferior (em %) onde a base das pilhas pode estar.
FLOOR_Y_PCT=100

# ---------------------------- SNAPSHOTS ------------------------------------
# Grava imagens automaticamente (contagem mudou, pilha apareceu, etc.).
SAVE_SNAPSHOTS=true
# 0 = somente por evento. Ex.: 300 = um a cada 5 minutos.
SNAPSHOT_INTERVAL_SEC=0
SNAPSHOT_ON_COUNT_CHANGE=true
SNAPSHOT_ON_PILE_APPEAR=true
SNAPSHOT_ON_PILE_DISAPPEAR=true
SNAPSHOT_ON_LOW_CONFIDENCE=true
SNAPSHOT_ON_RECONNECT=true
SNAPSHOT_JPEG_QUALITY=85
# 0 = nunca apagar automaticamente. Ex.: 30 = mantém 30 dias.
SNAPSHOT_KEEP_DAYS=0

# ------------------------------ ALERTAS ------------------------------------
ALERTS_ENABLED=true
# 0 = desativado
ALERT_TOTAL_MIN=0
ALERT_TOTAL_MAX=0
ALERT_PILE_MIN=0
ALERT_LOW_CONFIDENCE=0.50
ALERT_CAMERA_OFFLINE=true

# ------------------------------- SERVIDOR ----------------------------------
HOST=0.0.0.0
PORT=8000
# SQLite por padrão. Para PostgreSQL:
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/chairs
DATABASE_URL=sqlite:///./data/chairs.db
LOG_LEVEL=INFO
# FPS do stream MJPEG enviado ao navegador.
STREAM_FPS=8
# Frequência de atualização do WebSocket (mensagens por segundo).
WEBSOCKET_BROADCAST_HZ=2
CORS_ORIGINS=*

# ----------------------------- TREINAMENTO ---------------------------------
TRAINING_MODEL=yolo11n.pt
TRAINING_EPOCHS=100
TRAINING_IMAGE_SIZE=640
TRAINING_BATCH=16
# Vazio = usa o DEVICE da aplicação
TRAINING_DEVICE=
TRAINING_WORKERS=4
TRAINING_PATIENCE=50
TRAINING_SEED=42
TRAINING_PROJECT=training/runs
